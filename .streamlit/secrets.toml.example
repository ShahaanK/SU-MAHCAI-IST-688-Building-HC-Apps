# Copy this file to .streamlit/secrets.toml and fill in your own keys.
# The real secrets.toml is gitignored and must never be committed.

# Required. https://platform.openai.com/api-keys
OPENAI_API_KEY = "sk-..."

# Required only for the OpenRouter options in the HW 2 sidebar.
# https://openrouter.ai/keys
OPENROUTER_API_KEY = "sk-or-v1-..."
